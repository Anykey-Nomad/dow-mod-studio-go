#include <winver.h>

// The window class loads IDI_APPLICATION first and falls back to icon group 1,
// so a single icon here is what the title bar and Explorer both show.
1 ICON "icon.ico"

// RT_MANIFEST with the standard process id: DPI awareness and supported OS set.
1 24 "dow-mod-studio.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AnykeyNomad\0"
            VALUE "FileDescription",  "Dawn of War modding studio\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "dow-mod-studio\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 AnykeyNomad\0"
            VALUE "OriginalFilename", "dow-mod-studio.exe\0"
            VALUE "ProductName", "DoW Mod Studio\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
